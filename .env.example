# Copie ce fichier en ".env" et adapte les valeurs avant de lancer le forum

# En production, Node écoute uniquement sur l'interface locale ; Nginx est le seul point d'entrée public.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=loopback

# Facultatif : chemin absolu vers le fichier SQLite
# DB_PATH=/home/utilisateur/forum/db/forum.sqlite3
# SESSION_DB_PATH=/home/utilisateur/forum/db/sessions.sqlite3
# UPLOAD_DIR=/home/utilisateur/forum/storage/uploads

# Nom du forum affiché partout dans les templates
SITE_NAME=Alchimie

# URL publique absolue utilisée dans les liens de validation reçus par e-mail
SITE_URL=http://localhost:3000

# Informations publiques du pied de page et de la page légale
SITE_START_YEAR=2026
CONTACT_EMAIL=contact@votre-domaine.fr
REPORT_EMAIL=signalement@votre-domaine.fr
LEGAL_PUBLISHER_NAME=Nom ou raison sociale de l'éditeur
LEGAL_PUBLISHER_STATUS=Statut juridique et numéro d'immatriculation si applicable
LEGAL_PUBLISHER_ADDRESS=Adresse postale de l'éditeur
LEGAL_PUBLICATION_DIRECTOR=Nom du directeur de la publication
LEGAL_HOST_NAME=Nom ou raison sociale de l'hébergeur
LEGAL_HOST_ADDRESS=Adresse et téléphone de l'hébergeur
LEGAL_UPDATED_AT=13 août 2026

# Chaîne secrète utilisée pour signer les cookies de session.
# Génère-en une aléatoire avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_moi_en_une_longue_chaine_aleatoire

# Clé distincte utilisée pour pseudonymiser les adresses réseau des journaux.
# SECURITY_LOG_KEY=<64 caractères hexadécimaux aléatoires>
SECURITY_LOG_KEY=change_moi_avec_un_secret_distinct_de_64_caracteres

# Clé AES de 32 octets protégeant les adresses e-mail et les messages privés dans la BDD.
# Obligatoire en production. Ne la perds pas : sans elle, les données chiffrées sont irrécupérables.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=change_moi_avec_64_caracteres_hexadecimaux

# Passe à "true" une fois le site servi en HTTPS derrière Nginx (cookies "secure")
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
# Durée absolue maximale d'une authentification, même si le compte reste actif.
AUTH_SESSION_MAX_HOURS=168
MODERATION_SESSION_MINUTES=30

# Pseudo/mot de passe du tout premier compte admin, créés automatiquement au premier démarrage
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@votre-domaine.fr
ADMIN_PASSWORD=change_moi_mot_de_passe_admin

# Second mot de passe partagé du centre de contrôle, utilisé uniquement lors
# de sa toute première initialisation. Il pourra ensuite être changé par un développeur.
MODERATION_PASSWORD=1234

# Garde-fous globaux du stockage d'images (valeurs en octets / nombre de fichiers)
MAX_STORED_UPLOADS=10000
MAX_STORED_UPLOAD_BYTES=5368709120

# Bot Shield progressif. Les valeurs par défaut sont volontairement hautes pour
# ne pas gêner les utilisateurs normaux ni les flux temps réel du forum.
BOT_SHIELD_ENABLED=true
BOT_SHIELD_MAX_STRIKES=5
BOT_SHIELD_FLOOD_WARNING=240
BOT_SHIELD_FLOOD_BAN=360

# Sauvegardes SQLite cohérentes
# BACKUP_DIR=/var/lib/avebar/backups
BACKUP_RETENTION_DAYS=14

# Envoi des e-mails de validation (exemple compatible SMTP classique)
# Sans ces valeurs en local, le lien est affiché dans le terminal de développement.
SMTP_HOST=smtp.votre-fournisseur.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-compte-smtp
SMTP_PASS=votre-mot-de-passe-smtp
MAIL_FROM=Alchimie <noreply@votre-domaine.fr>
