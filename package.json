{
  "name": "forum-avenoel-like",
  "version": "1.0.0",
  "description": "Alchimie, forum communautaire web auto-hébergé",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server.js",
    "seed": "node db/seed.js",
    "demo": "node db/demo-content.js",
    "consolidate-forums": "node db/consolidate-forums.js",
    "backup": "node scripts/backup.js",
    "security:check": "node scripts/security-check.js",
    "performance:check": "node scripts/performance-check.js",
    "audit:http": "node scripts/http-check.js",
    "audit:local": "npm run security:check && npm run performance:check",
    "audit:release": "npm run audit:local && npm run audit:http"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "sanitize-html": "^2.13.0",
    "sharp": "0.35.3"
  }
}
