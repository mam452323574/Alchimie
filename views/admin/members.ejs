<%- include('../partials/header') %>
<%- include('shell-start') %>

<header class="admin-page-header">
  <div><p class="admin-kicker">Comptes et permissions</p><h1>Gestion des membres</h1><p>Recherche, contrôle des statuts et attribution des rôles autorisés.</p></div>
  <button class="admin-primary-action" type="button" data-sanction-dialog data-username="" data-type="ban"><span class="glyphicon glyphicon-ban-circle"></span>Sanctionner par pseudo</button>
</header>

<section class="admin-card">
  <div class="admin-card-head"><div><p class="admin-kicker">Annuaire interne</p><h2>Membres</h2></div><span class="admin-count-chip"><%= users.length %> résultat<%= users.length > 1 ? 's' : '' %></span></div>
  <form class="admin-filter-bar" action="/admin/membres" method="GET"><label><span class="glyphicon glyphicon-search"></span><input type="search" name="q" value="<%= search %>" placeholder="Pseudo ou adresse e-mail"></label><select name="role"><option value="">Tous les rôles</option><% ['member','moderator','admin','developer'].forEach(role => { %><option value="<%= role %>" <%= roleFilter === role ? 'selected' : '' %>><%= roleLabels[role] %></option><% }) %></select><select name="status"><option value="">Tous les statuts</option><option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Actifs</option><option value="sanctioned" <%= statusFilter === 'sanctioned' ? 'selected' : '' %>>Sanctionnés</option></select><button type="submit">Filtrer</button><% if (search || roleFilter || statusFilter) { %><a href="/admin/membres">Réinitialiser</a><% } %></form>
  <div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>Membre</th><th>Rôle</th><th>Inscription</th><th>Messages</th><th>Statut</th><th class="admin-actions-column">Actions</th></tr></thead><tbody>
    <% users.forEach(u => { %><tr><td><div class="admin-user-cell"><%- include('../partials/avatar', { imageUrl: u.avatar_url, imageClass: 'admin-user-avatar', altText: `Avatar de ${u.username}`, sanction: u.active_sanction, sanctionUntil: u.sanction_ends_at, wrapperClass: 'avatar-status-admin' }) %><div><a class="role-name-<%= u.role %>" href="/membre/<%= u.username %>"><%= u.username %></a><small><%= u.email || 'E-mail non renseigné' %></small></div></div></td><td><% if ((currentUser.role === 'developer' && u.id !== currentUser.id) || (currentUser.role === 'admin' && u.role !== 'developer' && u.id !== currentUser.id)) { %><form action="/admin/membres/<%= u.id %>/role" method="POST" class="admin-role-form"><select name="role"><option value="member" <%= u.role === 'member' ? 'selected' : '' %>>Membre</option><option value="moderator" <%= u.role === 'moderator' ? 'selected' : '' %>>Modérateur</option><% if (currentUser.role === 'developer') { %><option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrateur</option><option value="developer" <%= u.role === 'developer' ? 'selected' : '' %>>Développeur</option><% } %></select><button type="submit">OK</button></form><% } else { %><span class="admin-role-label role-name-<%= u.role %>"><%= roleLabels[u.role] %></span><% } %></td><td><%= u.created_at.slice(0,10) %></td><td><%= u.message_count %></td><td><span class="admin-state <%= u.active_sanction ? 'state-danger' : 'state-ok' %>"><%= u.active_sanction ? (u.active_sanction === 'eradication' ? 'Éradiqué' : u.active_sanction === 'ban' ? 'Banni' : 'Exclu') : 'Actif' %></span><% if (u.sanction_ends_at) { %><small class="admin-cell-note">jusqu’au <%= u.sanction_ends_at %></small><% } %></td><td><% if (u.id !== currentUser.id && u.role !== 'developer') { %><div class="admin-row-actions"><button class="action-exclude" type="button" data-sanction-dialog data-user-id="<%= u.id %>" data-username="<%= u.username %>" data-type="exclusion">Exclure</button><button class="action-ban" type="button" data-sanction-dialog data-user-id="<%= u.id %>" data-username="<%= u.username %>" data-type="ban">Bannir</button><button class="action-eradicate" type="button" data-sanction-dialog data-user-id="<%= u.id %>" data-username="<%= u.username %>" data-type="eradication">Éradiquer</button></div><% } %></td></tr><% }) %>
    <% if (!users.length) { %><tr><td colspan="6" class="admin-empty-line">Aucun membre ne correspond aux filtres.</td></tr><% } %>
  </tbody></table></div>
</section>

<%- include('../partials/sanction-dialog') %>
<script src="/js/forum.js" defer></script>
<%- include('shell-end') %>
<%- include('../partials/footer') %>
