<%- include('../partials/header') %>
<section class="auth-card">
  <p class="eyebrow">Créer un compte</p>
  <h1>Rejoins <%= siteName %></h1>
  <p class="form-help">Ton compte ne sera créé qu’après validation du lien reçu par e-mail.</p>
  <% if (error) { %><p class="error notice"><%= error %></p><% } %>
  <form action="/inscription" method="POST" class="std-form narrow">
    <label for="username">Pseudo</label>
    <input id="username" type="text" name="username" required value="<%= oldUsername %>" maxlength="20" autocomplete="username">
    <label for="email">Adresse e-mail</label>
    <input id="email" type="email" name="email" required value="<%= oldEmail %>" maxlength="254" autocomplete="email">
    <label for="password">Mot de passe</label>
    <input id="password" type="password" name="password" required minlength="12" maxlength="72" autocomplete="new-password">
    <label for="password-confirm">Confirmer le mot de passe</label>
    <input id="password-confirm" type="password" name="password_confirm" required minlength="12" maxlength="72" autocomplete="new-password">
    <button class="btn" type="submit">Recevoir le lien de validation</button>
  </form>
  <p>Déjà inscrit ? <a href="/connexion">Connecte-toi</a>.</p>
</section>
<%- include('../partials/footer') %>
