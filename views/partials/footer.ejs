</main>
<footer class="site-footer">
  <div class="wrap">
    <p class="footer-brand"><strong><%= siteName %> v<%= siteVersion %></strong> © <%= siteStartYear %><%= currentYear > siteStartYear ? '-' + currentYear : '' %></p>
    <p>Temps d’exécution : <%= executionTime() %>s</p>
    <nav class="footer-links" aria-label="Informations légales"><a href="/etat-du-service">État du service</a><span>|</span><a href="/cgu">Conditions Générales d’Utilisation</a><span>|</span><a href="/cgu#cookies">Cookies</a><span>|</span><% if (contactEmail) { %><a href="mailto:<%= contactEmail %>">Contact Mail</a><% } else { %><a href="/cgu#contact">Contact Mail</a><% } %><span>|</span><% if (reportEmail) { %><a href="mailto:<%= reportEmail %>?subject=<%= encodeURIComponent('Signalement de contenu sur ' + siteName) %>">Signaler un contenu</a><% } else { %><a href="/cgu#signalement">Signaler un contenu</a><% } %></nav>
    <p class="footer-webmasters">Webmasters : <% webmasters.forEach((webmaster, index) => { %><%= index ? ', ' : '' %><a href="/membre/<%= webmaster.username %>"><%= webmaster.username %></a><% }) %><% if (!webmasters.length) { %><span>Équipe <%= siteName %></span><% } %></p>
  </div>
</footer>
<script src="/js/media-viewer.js" defer></script>
</body>
</html>
