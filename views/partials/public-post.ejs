<article class="post <%= p.deleted_at ? 'post-deleted' : '' %>" id="post-<%= p.id %>">
  <aside class="post-side">
    <%- include('avatar', { imageUrl: p.avatar_url, imageClass: `post-avatar-image ${p.avatar_url && /\.gif(?:$|\?)/i.test(p.avatar_url) ? 'post-avatar-gif' : ''}`, altText: `Avatar de ${p.username}`, sanction: p.active_sanction, sanctionUntil: p.sanction_ends_at, wrapperClass: 'avatar-status-post' }) %>
    <span class="post-count"><strong><%= p.message_count %></strong> messages</span><span class="post-points"><strong><%= p.points %></strong> points · <span class="rank-name rank-<%= p.rank.key %>"><%= p.rank.label %></span></span><span class="post-since">Inscrit le <%= p.user_created_at.slice(0,10) %></span>
  </aside>
  <div class="post-body">
    <div class="post-meta"><div class="post-meta-author"><a class="post-username role-name-<%= p.role %>" href="/membre/<%= p.username %>"><%= p.username %></a><span>Posté le <%= p.created_at %><% if (p.edited_at) { %> · modifié<% } %></span></div><div class="post-meta-controls"><% if (!p.deleted_at && p.can_moderate) { %><div class="post-moderation"><button class="pill-action pill-exclude" type="button" title="Exclure" aria-label="Exclure <%= p.username %>" data-sanction-dialog data-user-id="<%= p.user_id %>" data-username="<%= p.username %>" data-type="exclusion">⏱</button><button class="pill-action pill-ban" type="button" title="Bannir" aria-label="Bannir <%= p.username %>" data-sanction-dialog data-user-id="<%= p.user_id %>" data-username="<%= p.username %>" data-type="ban">⊘</button><button class="pill-action pill-eradicate" type="button" title="Éradiquer" aria-label="Éradiquer <%= p.username %>" data-sanction-dialog data-user-id="<%= p.user_id %>" data-username="<%= p.username %>" data-type="eradication">☠</button></div><% } %><% if (p.deleted_at && moderationUnlocked && !(p.is_first_post && thread.deleted_at)) { %><form action="/message/<%= p.id %>/restaurer" method="POST" class="inline-form"><button class="restore-inline" type="submit">Restaurer</button></form><% } %><a href="#post-<%= p.id %>">#<%= p.id %></a></div></div>
    <% if (p.deleted_at) { %><div class="deleted-notice deleted-post-notice"><strong>Message supprimé</strong><span>Masqué le <%= p.deleted_at %><%= p.deleted_by_name ? ' par ' + p.deleted_by_name : '' %><%= p.deletion_reason ? ' - ' + p.deletion_reason : '' %></span></div><% } %>
    <% if (p.parent_post_id) { %><a class="reply-context" href="#post-<%= p.parent_post_id %>"><span>↳ Réponse à <strong class="role-name-<%= p.parent_role %>"><%= p.parent_username %></strong> · message #<%= p.parent_post_id %></span><small><%= p.parent_body.slice(0, 180) %><%= p.parent_body.length > 180 ? '…' : '' %></small></a><% } %>
    <div class="post-content"><%- formatPostBody(p.body) %></div>
    <% if (poll) { %><section class="poll-card"><div class="poll-head"><span>SONDAGE</span><h3><%= poll.question %></h3><small><%= poll.totalVotes %> vote<%= poll.totalVotes > 1 ? 's' : '' %></small></div><form action="/sondage/<%= poll.id %>/voter" method="POST"><% poll.options.forEach(option => { const percent = poll.totalVotes ? Math.round(option.votes / poll.totalVotes * 100) : 0; %><label class="poll-option"><input type="radio" name="option_id" value="<%= option.id %>" <%= poll.userOptionId === option.id ? 'checked' : '' %> <%= currentUser ? '' : 'disabled' %>><span><strong><%= option.label %></strong><small><%= option.votes %> · <%= percent %>%</small><i style="width:<%= percent %>%"></i></span></label><% }) %><% if (currentUser) { %><button class="btn-small" type="submit">Voter</button><% } else { %><p class="field-hint"><a href="/connexion">Connecte-toi</a> pour voter.</p><% } %></form></section><% } %>
    <% if (p.signature) { %><div class="post-signature"><%= p.signature %></div><% } %>
    <% if (currentUser && !p.deleted_at && !thread.deleted_at) { %><div class="post-actions"><% if (!thread.is_locked) { %><button type="button" class="link-btn reply-action" data-reply-post data-post-id="<%= p.id %>" data-username="<%= p.username %>">↩ Répondre</button><% } %><% if (currentUser.id === p.user_id || (moderationUnlocked && ['admin','developer'].includes(currentUser.role))) { %><a href="/message/<%= p.id %>/editer">Éditer</a><% if (!p.is_first_post) { %><form action="/message/<%= p.id %>/supprimer" method="POST" class="inline-form"><button type="submit" class="link-btn danger-link">Supprimer</button></form><% } %><% } %></div><% } %>
  </div>
</article>
