<%- include('../partials/header') %>
<section class="topic-panel private-conversation-panel" data-realtime-private-conversation data-conversation-id="<%= conversation.id %>" data-current-page="<%= page %>" data-total-pages="<%= totalPages %>" data-last-message-id="<%= messages.length ? messages[messages.length - 1].id : 0 %>">
  <div class="breadcrumb"><a href="/">Accueil</a> &nbsp;/&nbsp; <a href="/messages">Messages privés</a> &nbsp;/&nbsp; <%= conversation.title %></div>
  <div class="page-head private-conversation-heading"><div><p class="eyebrow">Conversation privée</p><h1><%= conversation.title %></h1></div><a class="btn btn-secondary" href="/messages">Boîte de réception</a></div>
  <div class="private-participant-list"><strong>Membres :</strong><% members.forEach(member => { %><a class="private-participant role-name-<%= member.role %>" href="/membre/<%= member.username %>"><%- include('../partials/avatar', { imageUrl: member.avatar_url, imageClass: 'private-participant-avatar', altText: `Avatar de ${member.username}`, sanction: member.active_sanction, sanctionUntil: member.sanction_ends_at, wrapperClass: 'avatar-status-participant' }) %><%= member.username %></a><% }) %></div>
  <% if (canManageMembers && members.length < maximumGroupMembers) { %>
    <details class="private-member-manager">
      <summary><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> Ajouter des membres</summary>
      <form action="/messages/<%= conversation.id %>/membres" method="POST" class="private-member-form">
        <input type="hidden" name="csrf_token" value="<%= privateMessageCsrfToken %>">
        <label for="private-new-members">Pseudonymes à inviter</label>
        <div><input id="private-new-members" type="text" name="participants" maxlength="500" required placeholder="Pseudo1, Pseudo2" list="private-invite-usernames" autocomplete="off"><button class="btn" type="submit">Ajouter</button></div>
        <datalist id="private-invite-usernames"><% suggestedUsers.forEach(user => { %><option value="<%= user.username %>"><%= roleLabels[user.role] %></option><% }) %></datalist>
        <p><strong>Attention :</strong> les personnes ajoutées pourront consulter tout l’historique de ce MP. <%= maximumGroupMembers - members.length %> place<%= maximumGroupMembers - members.length > 1 ? 's' : '' %> disponible<%= maximumGroupMembers - members.length > 1 ? 's' : '' %>.</p>
      </form>
    </details>
  <% } %>
  <%- include('../partials/pagination') %>
  <a class="realtime-new-message" href="#" data-realtime-new-message hidden></a>
  <div data-realtime-message-list><%- include('_message-list', { messages }) %></div>
  <%- include('../partials/pagination') %>
  <div class="typing-indicator" data-typing-indicator hidden aria-live="polite"><span data-typing-text></span><span class="typing-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
</section>
<a id="bas"></a>
<form action="/messages/<%= conversation.id %>/repondre" method="POST" class="reply-form private-reply-form" data-editor-form data-upload-scope="private" data-upload-conversation-id="<%= conversation.id %>" data-realtime-private-reply>
  <input type="hidden" name="csrf_token" value="<%= privateMessageCsrfToken %>">
  <div class="reply-head"><h3>Répondre au groupe</h3><span class="private-lock-note">🔒 <%= members.length %> membre<%= members.length > 1 ? 's' : '' %></span></div>
  <div class="editor-frame reply-editor-frame"><%- include('../partials/editor-toolbar') %><textarea name="body" rows="7" maxlength="20000" required placeholder="Ton message privé..." data-editor-input></textarea></div>
  <section class="editor-preview" data-editor-preview hidden><p class="eyebrow">Prévisualisation</p><div data-editor-preview-content></div></section>
  <div class="composer-actions"><button class="btn" type="submit">Envoyer le MP</button><button class="btn btn-secondary" type="button" data-editor-preview-toggle>Prévisualiser</button></div>
  <p class="realtime-form-feedback" data-realtime-form-feedback hidden></p>
</form>
<script src="/js/editor.js" defer></script>
<script src="/js/realtime.js" defer></script>
<%- include('../partials/footer') %>
